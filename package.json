{
  "name": "opencode-never-stop",
  "version": "0.1.5",
  "description": "opencode plugin: nudge the agent whenever it goes idle so it never stops working",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdementev/opencode-never-stopping.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "never-stop"
  ],
  "files": [
    "dist",
    "commands"
  ],
  "exports": {
    ".": {
      "types": "./dist/opencode-never-stop.d.ts",
      "import": "./dist/opencode-never-stop.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@opencode-ai/sdk": "^1.18.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
